# 签名材料模板：复制为 keystore.properties 并填真实值（keystore.properties 已 gitignore，不入库）。
# 仅 release 签名需要；debug 用 AGP 默认 debug keystore。
# 生成本地密钥库示例（详见 docs/release-signing.md）：
#   keytool -genkeypair -v -keystore rpandroid-release.jks -alias rpandroid \
#     -keyalg RSA -keysize 2048 -validity 10950 \
#     -dname "CN=RPAndroid, O=fellow99, C=CN"
storeFile=rpandroid-release.jks
storePassword=CHANGE_ME
keyAlias=rpandroid
keyPassword=CHANGE_ME
