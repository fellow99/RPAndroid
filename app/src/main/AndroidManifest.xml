<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 定时任务需要精确闹钟：Android 13+ 用 USE_EXACT_ALARM（安装即授予）；
         旧版用 SCHEDULE_EXACT_ALARM。MIUI 会回收 SCHEDULE_EXACT_ALARM，只靠它会导致
         cron 任务在息屏/待机时不触发（实测 exact_alarm_permission_revoked）。 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ 包可见性：声明“枚举所有带启动器的应用/读其图标”的意图查询，
         否则 queryIntentActivities(MAIN/LAUNCHER) 只会返回部分系统应用。
         用 <queries> 而非 QUERY_ALL_PACKAGES，避免过度授权。 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.INFO" />
        </intent>
    </queries>

    <application
        android:name=".ManagedApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ManagedFloatingApp">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".present.ScreenActivity"
            android:exported="false" />

        <service
            android:name=".ManagedService"
            android:exported="false" />

        <service
            android:name=".present.FloatingService"
            android:exported="false" />

        <service
            android:name=".script.ScriptService"
            android:exported="false"
            android:process=":node"
            android:foregroundServiceType="specialUse" />

        <receiver
            android:name=".script.AlarmReceiver"
            android:exported="false" />

        <!-- 重启后恢复：拉起服务器/会话自动恢复并重排 cron/interval 闹钟（否则重启后定时任务丢失）。
             系统广播（BOOT_COMPLETED / MY_PACKAGE_REPLACED）不要求 exported=true，保持 false 减小攻击面。 -->
        <receiver
            android:name=".script.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <provider
            android:name=".helper.HandoffProvider"
            android:authorities="com.managedfloating.app.helper"
            android:exported="true"
            android:grantUriPermissions="false" />

        <service
            android:name=".a11y.MfaAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
