<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:name=".ManagedApp"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ManagedFloatingApp">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".present.ScreenActivity"
            android:exported="false" />

        <service
            android:name=".ManagedService"
            android:exported="false" />

        <service
            android:name=".present.FloatingService"
            android:exported="false" />

        <service
            android:name=".script.ScriptService"
            android:exported="false"
            android:process=":node"
            android:foregroundServiceType="specialUse" />

        <receiver
            android:name=".script.AlarmReceiver"
            android:exported="false" />

        <provider
            android:name=".helper.HandoffProvider"
            android:authorities="com.managedfloating.app.helper"
            android:exported="true"
            android:grantUriPermissions="false" />

        <service
            android:name=".a11y.MfaAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
